{
  "name": "shorts-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "start": "node --import tsx src/server/index.ts",
    "check": "tsc --noEmit",
    "provision": "node --import tsx scripts/provision.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "coverage": "node --import tsx scripts/coverage.ts",
    "coverage:report": "node --import tsx scripts/coverage.ts --report-only"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-lib-source-maps": "^4.0.4",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "c8": "^12.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
