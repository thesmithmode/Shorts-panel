[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=Shorts Panel (independent of Stream Panel)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=shorts-panel
Group=shorts-panel
WorkingDirectory=/opt/shorts-panel/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=SHORTS_DATA_DIR=/var/lib/shorts-panel
EnvironmentFile=/etc/shorts-panel/server.env
# Node.js 24 runtime ships inside each immutable release (server system node is 22).
ExecStart=/opt/shorts-panel/current/bin/node --import tsx src/server/index.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shorts-panel
RestrictSUIDSGID=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
CPUWeight=20
CPUQuota=50%
IOWeight=20
Nice=10
MemoryHigh=384M
MemoryMax=512M
TasksMax=96

[Install]
WantedBy=multi-user.target
